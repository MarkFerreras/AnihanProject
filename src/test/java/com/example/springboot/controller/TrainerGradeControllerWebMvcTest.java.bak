package com.example.springboot.controller;

import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

import java.math.BigDecimal;
import java.util.List;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
import org.springframework.http.MediaType;
import org.springframework.security.test.context.support.WithMockUser;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.MockMvc;

import com.example.springboot.dto.trainer.GradeSummaryResponse;
import com.example.springboot.dto.trainer.SaveGradeRequest;
import com.example.springboot.dto.trainer.StudentGradeRow;
import com.example.springboot.service.TrainerGradeService;

@WebMvcTest(TrainerGradeController.class)
public class TrainerGradeControllerWebMvcTest {

    @Autowired
    private MockMvc mockMvc;

    @MockitoBean
    private TrainerGradeService gradeService;

    @Test
    @WithMockUser(roles = "TRAINER")
    void testGetGradesSuccess() throws Exception {
        Integer classId = 1;
        GradeSummaryResponse response = new GradeSummaryResponse(
                classId,
                "Culinary Arts",
                "Section A",
                "2026",
                false,
                List.of(
                        new StudentGradeRow(
                                "STU001",
                                "Doe",
                                "John",
                                "M",
                                new BigDecimal("4.0"),
                                new BigDecimal("3.5"),
                                new BigDecimal("3.7"),
                                null,
                                new BigDecimal("5.0"),
                                "Good",
                                new BigDecimal("3.85"),
                                false)));

        when(gradeService.getGradesForClass(classId)).thenReturn(response);

        mockMvc.perform(get("/api/trainer/classes/" + classId + "/grades")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.classId").value(classId))
                .andExpect(jsonPath("$.subjectName").value("Culinary Arts"))
                .andExpect(jsonPath("$.sectionName").value("Section A"))
                .andExpect(jsonPath("$.semester").value("2026"))
                .andExpect(jsonPath("$.locked").value(false))
                .andExpect(jsonPath("$.students.length()").value(1));
    }

    @Test
    @WithMockUser(roles = "TRAINER")
    void testGetGradesClassNotFound() throws Exception {
        Integer classId = 999;

        when(gradeService.getGradesForClass(classId))
                .thenThrow(new IllegalArgumentException("Class not found"));

        mockMvc.perform(get("/api/trainer/classes/" + classId + "/grades")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isBadRequest());
    }

    @Test
    @WithMockUser(roles = "TRAINER")
    void testGetGradesNotAssigned() throws Exception {
        Integer classId = 1;

        when(gradeService.getGradesForClass(classId))
                .thenThrow(new IllegalArgumentException("You are not assigned to this class"));

        mockMvc.perform(get("/api/trainer/classes/" + classId + "/grades")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isBadRequest());
    }

    @Test
    @WithMockUser(roles = "TRAINER")
    void testSaveGradesSuccess() throws Exception {
        Integer classId = 1;
        String gradeJsonPayload = "[{\"studentId\":\"STU001\",\"midtermGrade\":4.0,\"finalsGrade\":3.5,\"reExamGrade\":null,\"hoursStudied\":5.0,\"remarks\":\"Good\"}]";

        doNothing().when(gradeService).saveGrades(eq(classId), anyList());

        mockMvc.perform(put("/api/trainer/classes/" + classId + "/grades")
                .contentType(MediaType.APPLICATION_JSON)
                .content(gradeJsonPayload))
                .andExpect(status().isOk());

        verify(gradeService, times(1)).saveGrades(eq(classId), anyList());
    }

    @Test
    @WithMockUser(roles = "TRAINER")
    void testSaveGradesGradeLocked() throws Exception {
        Integer classId = 1;
        String gradeJsonPayload = "[{\"studentId\":\"STU001\",\"midtermGrade\":4.0,\"finalsGrade\":3.5,\"reExamGrade\":null,\"hoursStudied\":5.0,\"remarks\":\"Good\"}]";

        doThrow(new IllegalArgumentException("Grade is locked"))
                .when(gradeService).saveGrades(eq(classId), anyList());

        mockMvc.perform(put("/api/trainer/classes/" + classId + "/grades")
                .contentType(MediaType.APPLICATION_JSON)
                .content(gradeJsonPayload))
                .andExpect(status().isBadRequest());
    }

    @Test
    @WithMockUser(roles = "TRAINER")
    void testLockGradesSuccess() throws Exception {
        Integer classId = 1;

        doNothing().when(gradeService).lockGrades(classId);

        mockMvc.perform(post("/api/trainer/classes/" + classId + "/grades/lock")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk());

        verify(gradeService, times(1)).lockGrades(classId);
    }

    @Test
    @WithMockUser(roles = "TRAINER")
    void testUnlockGradesSuccess() throws Exception {
        Integer classId = 1;

        doNothing().when(gradeService).unlockGrades(classId);

        mockMvc.perform(post("/api/trainer/classes/" + classId + "/grades/unlock")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk());

        verify(gradeService, times(1)).unlockGrades(classId);
    }

    @Test
    void testGetGradesUnauthorized() throws Exception {
        Integer classId = 1;

        mockMvc.perform(get("/api/trainer/classes/" + classId + "/grades")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isUnauthorized());
    }

    @Test
    @WithMockUser(roles = "ADMIN")
    void testGetGradesForbidden() throws Exception {
        Integer classId = 1;

        mockMvc.perform(get("/api/trainer/classes/" + classId + "/grades")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isForbidden());
    }

    @Test
    @WithMockUser(roles = "TRAINER")
    void testLockGradesNotAssigned() throws Exception {
        Integer classId = 1;

        doThrow(new IllegalArgumentException("You are not assigned to this class"))
                .when(gradeService).lockGrades(classId);

        mockMvc.perform(post("/api/trainer/classes/" + classId + "/grades/lock")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isBadRequest());
    }
}
